{
  "name": "@sponsee/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./routers": {
      "import": "./dist/routers/index.js",
      "types": "./dist/routers/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:migrate:deploy": "node node_modules/@sponsee/db/dist/migrate.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@sponsee/db": "workspace:*",
    "@sponsee/shared": "workspace:*",
    "@trpc/server": "^11.0.0",
    "better-auth": "^1.2.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.14.0",
    "pg-boss": "^12.28.0",
    "superjson": "^2.2.0",
    "zod": "^3.25.76",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.0",
    "eslint": "^9.0.0",
    "globals": "^16.5.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.11"
  }
}
