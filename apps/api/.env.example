# ── Database (Neon / Lakebase Postgres) ──
# Org: Sponsee (org-fragrant-haze-95727566) · Project: Sponsee (shiny-unit-91967908)
# With NEON_API_KEY set, `neon env pull` fills both URLs from the linked branch (.neon).
# App traffic uses the pooled URL (-pooler host); migrations use the direct one.
DATABASE_URL=postgresql://localhost:5432/sponsee
DATABASE_URL_UNPOOLED=
NEON_API_KEY=
BETTER_AUTH_SECRET=dev-secret-change-in-production
BETTER_AUTH_URL=http://localhost:3001
WEB_URL=http://localhost:3000
PORT=3001

# ── Auth rate limiting ──
# On by default everywhere except the test runner. Counters live in the
# rate_limit table, so run migrations before deploying a host that enables it.
# AUTH_RATE_LIMIT_ENABLED=true
# Headers the client IP is read from, most trustworthy first. The default
# (x-vercel-forwarded-for, x-forwarded-for) covers Vercel and Render; override
# for a host that terminates elsewhere (e.g. cf-connecting-ip behind Cloudflare).
# AUTH_IP_HEADERS=x-vercel-forwarded-for,x-forwarded-for
# Proxy IPs/CIDRs to walk back through when the forwarded header is multi-hop.
# Without this a chained header is untrusted and every caller shares one bucket.
# AUTH_TRUSTED_PROXIES=

# OAuth (optional — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP / Mailpit in dev (port 1025 = Mailpit SMTP, 8025 = web UI)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sponsee.app

# ── Email provider config ──
# Provider: mailpit (dev/default) | postmark (recommended) | resend (fallback)
EMAIL_PROVIDER=mailpit
CHASE_FROM_EMAIL=chase@sponsee.app

# Postmark (production recommended)
POSTMARK_SERVER_TOKEN=

# Resend (fallback)
RESEND_API_KEY=

# Mailpit (dev only)
MAILPIT_URL=http://localhost:8025

# ── Stripe (test mode only — never commit live keys) ──
# Dev webhook forwarding:
#   stripe login
#   stripe listen --forward-to localhost:3001/api/webhooks/stripe
#   Copy the webhook signing secret to STRIPE_WEBHOOK_SECRET
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_CREATOR=price_...
STRIPE_PRICE_PRO=price_...
