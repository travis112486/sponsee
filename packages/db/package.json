{
  "name": "@sponsee/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "//files": "dist/migrate.js is the Render pre-deploy entrypoint and reads ../drizzle at runtime, so both must survive `pnpm deploy --prod` in apps/api/Dockerfile.",
  "files": [
    "dist",
    "drizzle"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema/index.js",
      "types": "./dist/schema/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:doctor": "tsx src/doctor.ts",
    "db:migrate": "tsx src/doctor.ts --preflight && drizzle-kit migrate && tsx src/doctor.ts",
    "db:migrate:deploy": "node dist/migrate.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:init": "tsx src/init.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.14.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  }
}
